#include <winver.h>
#include "fh2_version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     MOD_V1,MOD_V2,MOD_V3,0
 PRODUCTVERSION  MOD_V1,MOD_V2,MOD_V3,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_DLL
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Trinculo54"
            VALUE "FileDescription",  "WreckingBall: breakable trees, fences and poles for Forza Horizon 2"
            VALUE "FileVersion",      MOD_VERSION_STR
            VALUE "InternalName",     "WreckingBall"
            VALUE "OriginalFilename", "WreckingBall.dll"
            VALUE "ProductName",      "WreckingBall"
            VALUE "ProductVersion",   MOD_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
